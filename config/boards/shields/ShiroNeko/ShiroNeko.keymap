#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#define LOL 3
#define WASD 4
#define FUN 5
#define EXTRA 6
#define CHAT 7
/ {
    macros {
        tgchat: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &tog CHAT>
                , <&macro_tap &kp ENTER>
                ;
        };
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
    };
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp TAB>, <&caps_word>;
        };
        // tabsl: mod-tap-by-hold-tap {
        //     compatible = "zmk,behavior-hold-tap";
        //     label = "MOD_TAP_BY_HOLD_TAP";
        //     #binding-cells = <0>;
        //     tapping-term-ms = <200>;
        //     quick-tap-ms = <10>;
        //     flavor = "hold-preferred";
        //     bindings = <&caps_word>, <&kp TAB>;
        // };
        tlt: layer-tap-by-hold-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BY_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&to>, <&kp>;
        };
        
        
        
    };
    
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &mt RSHFT ENTER
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &mo EXTRA   &kp RALT   &kp RCTRL   &caps_word 
            >;
        };
        dvorak { // layer 1
            bindings = <
                &gresc      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5              &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp DEL
                &kp TAB     &kp APOS    &kp COMMA   &kp DOT     &kp P       &kp Y               &kp X       &kp G       &kp C       &kp R       &kp L       &kp BACKSPACE
                &kp LSHFT   &kp A       &kp O       &kp E       &kp U       &kp I               &kp D       &kp H       &kp T       &kp N       &kp S       &mt RSHFT ENTER
                &lm 8 LCTRL &kp SEMI    &kp Q       &kp J       &kp K       &kp F               &kp B       &kp M       &kp W       &kp V       &kp Z       &kp LSHFT  
                                        &mo FUN     &lm 8 LWIN  &lm 8 LALT  &kp SPACE           &mo EXTRA   &lm 8 RALT  &caps_word  &kp RCTRL
            >;
        };
        kitty { // Layer 2
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp P    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &mt RSHFT ENTER
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &kp SPACE   &mo EXTRA   &kp RCTRL   &caps_word 
            >;
        };

        league { // Layer 3
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5          &kp N6      &kp N7  &kp N8      &kp N9  &kp N0      &kp BACKSPACE
                &kp TAB     &kp A   &kp Q   &kp W   &kp E   &kp R           &kp Y       &kp U   &kp I       &kp O   &kp P       &kp BACKSLASH
                &kp LCTRL   &kp P   &kp A   &kp D   &kp D   &kp F           &kp H       &kp J   &kp K       &kp L   &kp SEMI    &tgchat 
                &kp LSHIFT  &kp Z   &kp X   &kp C   &kp V   &kp B           &kp N       &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT 
                                    &to 0   &kp T  &kp LALT  &kp SPACE      &kp SPACE   &kp RALT   &kp RCTRL   &kp RWIN 
            >;
        };
        wasd { // Layer 4
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &gresc      &kp Q    &kp N1     &kp N2  &kp N3  &kp N4          &kp N5      &kp N6  &kp N7      &kp N8  &kp N9      &kp BACKSPACE
                &kp TAB     &kp A    &kp W      &kp E   &kp R   &kp T           &kp Y       &kp U   &kp I       &kp O   &kp N0      &kp BACKSLASH
                &kp LSHFT   &kp Z    &kp S      &kp D   &kp F   &kp G           &kp H       &kp J   &kp K       &kp L   &kp SEMI    &kp ENTER
                &kp LCTRL   &kp P    &tlt 0  X  &kp C   &kp V   &kp B           &kp N       &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                     &kp M  &kp J  &mt LALT I  &kp SPACE          &kp SPACE   &kp RALT   &kp RWIN    &kp DOT 
            >;
        };
        functal { // Layer 5           
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &kp F1  &kp F2  &kp F3      &kp F4      &kp F5      &kp F6                  &kp F7  &kp F8          &kp F9          &kp F10         &kp F11 &kp F12
                &kp CAPS &to 0  &to LOL     &to WASD    &to 2       &to 1                   &none   &none           &kp UP_ARROW    &none           &none   &none
                &none   &none    &none    &none     &bt BT_CLR_ALL   &bt BT_CLR             &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW &none   &none
                &sk LALT &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none          &none   &none           &none           &none           &none   &none  
                                 &none    &none     &kp LALT   &kp ENTER                    &none   &none           &none           &none 
            >;
        };
        extras { // Layer 6
            // -------------------------------------
            //  |    F1     |     F2    |     F3    |    F4     | 
            //  |     A     |     B     |     C     |
            //  |     D     |     E     |     F     |
            bindings = <
                &kp F1      &kp F2      &kp F3  &kp F4      &kp F5      &kp F6                  &kp F7      &kp F8      &kp F9      &kp F10     &kp F11   &kp EQUAL
                &none       &kp EXCL    &kp AT  &kp HASH    &kp DLLR    &kp PRCNT               &kp CARET   &kp AMPS    &kp STAR    &kp LT      &kp GT      &kp MINUS
                &kp RSHIFT  &kp DQT     &none   &kp LBRC    &kp RBRC    &kp LBKT                &kp RBKT    &kp LPAR    &kp RPAR    &kp EQUAL   &kp APOS    &kp RSHIFT
                &sk LALT    &none       &none   &none       &none       &kp SLASH               &kp BSLH    &kp MINUS   &kp MINUS    &kp PLUS       &none       &none
                                        &none   &none       &kp LALT    &kp ENTER               &none       &none       &none       &none 
            >;
        };
        chat { // layer  7
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &tog CHAT   &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &tgchat
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &mo EXTRA   &kp RALT   &kp RCTRL   &caps_word 
            >;
        };
                
        qwerty { // Layer 8            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &mt RSHFT ENTER
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &mo EXTRA   &kp RALT   &kp RCTRL   &caps_word 
            >;
        };
    };
};

