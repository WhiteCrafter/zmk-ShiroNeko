#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#define LOL 3
#define GAME 4
#define FUN 6
#define EXTRA 7
#define CHAT 8
#define QW 9
#define MATH 10
/ {
    macros {
        tgchat: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &tog CHAT>
                , <&macro_tap &kp ENTER>
                ;
        };
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };
    };
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp TAB>, <&caps_word>;
        };
        // tabsl: mod-tap-by-hold-tap {
        //     compatible = "zmk,behavior-hold-tap";
        //     label = "MOD_TAP_BY_HOLD_TAP";
        //     #binding-cells = <0>;
        //     tapping-term-ms = <200>;
        //     quick-tap-ms = <10>;
        //     flavor = "hold-preferred";
        //     bindings = <&caps_word>, <&kp TAB>;
        // };
        tlt: layer-tap-by-hold-tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_BY_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&to>, <&kp>;
        };
        
        
        
    };
    
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &mt RSHFT ENTER
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &mo EXTRA   &mo MATH   &caps_word   &kp RCTRL
            >;
        };
        dvorak { // layer 1
            bindings = <
                &gresc      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5              &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp DEL
                &kp TAB     &kp APOS    &kp COMMA   &kp DOT     &kp P       &kp Y               &kp X       &kp G       &kp C       &kp R       &kp L       &kp BACKSPACE
                &kp LSHFT   &kp A       &kp O       &kp E       &kp U       &kp I               &kp D       &kp H       &kp T       &kp N       &kp S       &mt RSHFT ENTER
                &lm QW LCTRL &kp SEMI   &kp Q       &kp J       &kp K       &kp F               &kp B       &kp M       &kp W       &kp V       &kp Z       &kp LSHFT  
                                        &mo FUN     &lm QW LWIN &lm QW LALT &kp SPACE           &mo EXTRA   &mo MATH   &caps_word  &kp RCTRL
            >;
        };
        kitty { // Layer 2
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &mt RSHFT ENTER
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &kp SPACE   &mo EXTRA   &mo MATH    &caps_word 
            >;
        };

        league { //       L4        ┌───────┬───────┬───────┬───────┐               ┌───────┬───────┬───────┬───────┐
            //  ┌───────────┬───────┤   1   |   2   |   3   |   4   │               │   5   |   6   |   7   |   8   ├───────┬───────────┐
            //  │   gresq   |   5   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   9   │    DELL   │      
            //  ├───────────┼───────┤   Q   |   W   |   E   |   R   │               │   Y   |   U   |   I   |   O   ├───────┼───────────┤
            //  │    TAB    |   A   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   P   │    <--    │
            //  ├───────────┼───────┤   A   |   S   |   D   |   F   │   ---------   │   H   |   J   |   K   |   L   ├───────┼───────────┤
            //  │   LCTRL   |   P   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   ;   │   ↵chat   │
            //  ├───────────┼───────┤   X   |   U   |   C   |   B   │               |   N   |   M   |   ,   |   .   ├───────┼───────────┤
            //  │   LSHIFT  |   Z   ├╤══════╧╤══════╧╤══════╧╤══════╧══╕         ╒══╧══════╤╧══════╤╧══════╤╧══════╤┤   /   │   LSHIFT  │
            //  └───────────┴───────┘│  to0  |   T   |  ALT  |  SPACE  │         |   CHAT  |  RALT | RCTRL |  WIN  |└───────┴───────────┘
            //                       └───────┴───────┴───────┴─────────┘         └─────────┴───────┴───────┴───────┘
            bindings = <
                &gresc      &kp N5  &kp N1  &kp N2  &kp N3  &kp N4          &kp N6      &kp N7  &kp N8      &kp N9  &kp N0      &kp DELETE
                &kp TAB     &kp A   &kp Q   &kp W   &kp E   &kp R           &kp Y       &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LCTRL   &kp P   &kp A   &kp S   &kp D   &kp F           &kp H       &kp J   &kp K       &kp L   &kp SEMI    &tgchat 
                &kp LSHIFT  &kp Z   &kp X   &kp U   &kp C   &kp B           &kp N       &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT 
                                    &to 0   &kp T  &kp LALT &kp SPACE       &tog CHAT   &kp RALT &kp RCTRL  &kp RWIN 
            >;
        };
        game { //         L4        ┌───────┬───────┬───────┬───────┐               ┌───────┬───────┬───────┬───────┐
            //  ┌───────────┬───────┤   1   |   2   |   3   |   4   │               │   5   |   6   |   7   |   8   ├───────┬───────────┐
            //  │   gresq   |   Q   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   9   │    CHAT   │      
            //  ├───────────┼───────┤   W   |   E   |   R   |   T   │               │   Y   |   U   |   I   |   ↑   ├───────┼───────────┤
            //  │    TAB    |   A   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   →   │    <--    │
            //  ├───────────┼───────┤   S   |   D   |   F   |   G   │   ---------   │   H   |   J   |   ←   |   ↓   ├───────┼───────────┤
            //  │   LSHIFT  |   L   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   P   │     ↵     │
            //  ├───────────┼───────┤   X   |   C   |   V   |   B   │               |   ,   |   ,   |   /   |   N   ├───────┼───────────┤
            //  │   LCTRL   |   P   ├╤══════╧╤══════╧╤══════╧╤══════╧══╕         ╒══╧══════╤╧══════╤╧══════╤╧══════╤┤   M   │   LSHIFT  │
            //  └───────────┴───────┘│   M   |game2/J| ALT/I |  SPACE  │         |   CHAT  |  ALT  |  RWIN |   .   |└───────┴───────────┘
            //                       └───────┴───────┴───────┴─────────┘         └─────────┴───────┴───────┴───────┘
            bindings = <
                &gresc      &kp Q    &kp N1     &kp N2  &kp N3      &kp N4          &kp N5      &kp N6      &kp N7          &kp N8              &kp N9              &tog CHAT
                &kp TAB     &kp A    &kp W      &kp E   &kp R       &kp T           &kp Y       &kp U       &kp I           &kp UP_ARROW        &kp RIGHT_ARROW     &kp BACKSPACE
                &kp LSHFT   &kp L    &kp S      &kp D   &kp F       &kp G           &kp H       &kp J       &kp LEFT_ARROW  &kp DOWN_ARROW      &kp P               &kp ENTER
                &kp LCTRL   &kp P    &tlt 0  X  &kp C   &kp V       &kp B           &kp COMMA   &kp DOT     &kp SLASH       &kp N               &kp M               &kp LSHFT  
                                     &kp M      &lt 5 J &mt LALT I  &kp SPACE       &tog CHAT   &kp RALT    &kp RWIN        &kp DOT 
            >;
        };
        game2 {//         L4        ┌───────┬───────┬───────┬───────┐               ┌───────┬───────┬───────┬───────┐
            //  ┌───────────┬───────┤   6   |   7   |   8   |   9   │               │   5   |   6   |   7   |   8   ├───────┬───────────┐
            //  │     0     |   5   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   9   │    CHAT   │      
            //  ├───────────┼───────┤   W   |   E   |   U   |   O   │               │   Y   |   U   |   I   |   ↑   ├───────┼───────────┤
            //  │    TAB    |   A   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   →   │    <--    │
            //  ├───────────┼───────┤   S   |   D   |   K   |   L   │   ---------   │   H   |   J   |   ←   |   ↓   ├───────┼───────────┤
            //  │   LSHIFT  |   Z   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   P   │     ↵     │
            //  ├───────────┼───────┤   X   |   ,   |   .   |   /   │               |   ,   |   ,   |   /   |   N   ├───────┼───────────┤
            //  │   LCTRL   |   P   ├╤══════╧╤══════╧╤══════╧╤══════╧══╕         ╒══╧══════╤╧══════╤╧══════╤╧══════╤┤   M   │   LSHIFT  │
            //  └───────────┴───────┘│   M   |ooooooo|  RALT |   <--   │         |         |ooooooo|   0   |       |└───────┴───────────┘
            //                       └───────┴───────┴───────┴─────────┘         └─────────┴───────┴───────┴───────┘
            bindings = <
                &kp N0      &kp N5   &kp N6     &kp N7      &kp N8    &kp N9            &kp N5      &kp N6  &kp N7      &kp N8  &kp N9      &kp DELETE
                &kp TAB     &kp A    &kp W      &kp Y       &kp U     &kp O             &kp Y       &kp U   &kp I       &kp O   &kp N0      &kp BACKSPACE
                &kp LSHFT   &kp Z    &kp S      &kp D       &kp K     &kp L             &kp H       &kp J   &kp K       &kp L   &kp SEMI    &kp ENTER
                &kp LCTRL   &kp P    &tlt 0  X  &kp COMMA   &kp DOT   &kp SLASH         &kp N       &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                     &kp M      &none       &kp RALT  &kp BACKSPACE     &tog CHAT   &kp RALT &kp RWIN   &kp DOT 
            >;
        };
        functal { // Layer 6           
            bindings = <
                &kp F1      &kp F2          &kp F3      &kp F4      &kp F5          &kp F6                  &kp F7  &kp F8          &kp F9          &kp F10         &kp F11 &kp F12
                &kp CAPS    &to 0           &to LOL     &to GAME    &to 2           &to 1                   &none   &none           &kp UP_ARROW    &none           &none   &none
                &none       &studio_unlock  &none       &none       &bt BT_CLR_ALL  &bt BT_CLR              &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW &none   &none
                &sk LALT  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4    &none                   &none   &none           &none           &none           &none   &none  
                                            &none       &none       &kp LALT        &kp SPACE               &none   &none           &none           &none 
            >;
        };
        extras {//        L7        ┌───────┬───────┬───────┬───────┐               ┌───────┬───────┬───────┬───────┐
            //  ┌───────────┬───────┤   F3  |   F4  |   F5  |   F6  |               |   F7  |   F8  |   F9  |  F10  ├───────┬───────────┐
            //  │     F1    |   F2  ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤  F11  |    F12    │      
            //  ├───────────┼───────┤   @   |   #   |   $   |   %   │               │   ^   |   &   |   *   |   <   ├───────┼───────────┤
            //  │    TAB    |   !   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   >   |     -     |
            //  ├───────────┼───────┤xxxxxxx|   {   |   }   |   [   │   ---------   │   H   |   J   |   ←   |   ↓   ├───────┼───────────┤
            //  │   RSHIFT  |xxxxxxx├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   '   |   LSHIFT  │
            //  ├───────────┼───────┤xxxxxxx|   <   |   >   |   /   │               │   ,   │   ,   │   /   |   N   ├───────┼───────────┤
            //  │   LCTRL   |xxxxxxx├╤══════╧╤══════╧╤══════╧╤══════╧══╕         ╒══╧══════╤╧══════╤╧══════╤╧══════╤┤xxxxxxx|xxxxxxxxxxx│
            //  └───────────┴───────┘│xxxxxxx|xxxxxxx|  LALT |   ' '   │         │ooooooooo|xxxxxxx|xxxxxxx|xxxxxxx|└───────┴───────────┘
            //                       └───────┴───────┴───────┴─────────┘         └─────────┴───────┴───────┴───────┘
            bindings = <
                &kp F1      &kp F2      &kp F3  &kp F4      &kp F5      &kp F6                  &kp F7      &kp F8      &kp F9      &kp F10     &kp F11     &kp F12
                &kp TAB     &kp EXCL    &kp AT  &kp HASH    &kp DLLR    &kp PRCNT               &kp CARET   &kp AMPS    &kp STAR    &kp LT      &kp GT      &kp MINUS
                &kp RSHIFT  &kp DQT     &none   &kp LBRC    &kp RBRC    &kp LBKT                &kp RBKT    &kp LPAR    &kp RPAR    &kp EQUAL   &kp APOS    &kp LSHIFT
                &kp LCTRL   &none       &none   &kp LT      &kp GT      &kp SLASH               &kp BSLH    &kp MINUS   &kp MINUS   &kp PLUS    &none       &none
                                        &none   &none       &kp LALT    &kp SPACE               &none       &none       &none       &none 
            >;
        };
        chat { // layer  8 for in game chat
            bindings = <
                &tog CHAT   &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp ENTER
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &tgchat
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &mo EXTRA   &mo MATH   &caps_word   &kp RCTRL 
            >;
        };
                
        qwerty { // Layer 9            // -------------------------------------
            bindings = <
                &gresc      &kp N1  &kp N2  &kp N3      &kp N4   &kp N5             &kp N6  &kp N7  &kp N8      &kp N9  &kp N0      &kp DEL
                &kp TAB     &kp Q   &kp W   &kp E       &kp R    &kp T              &kp Y   &kp U   &kp I       &kp O   &kp P       &kp BACKSPACE
                &kp LSHFT   &kp A   &kp S   &kp D       &kp F    &kp G              &kp H   &kp J   &kp K       &kp L   &kp SEMI    &mt RSHFT ENTER
                &kp LCTRL   &kp Z   &kp X   &kp C       &kp V    &kp B              &kp N   &kp M   &kp COMMA   &kp DOT &kp SLASH   &kp LSHFT  
                                    &mo FUN &kp LWIN    &kp LALT &kp SPACE          &mo EXTRA   &kp RALT   &caps_word   &kp RCTRL 
            >;
        };
        math {//         L10        ┌───────┬───────┬───────┬───────┐               ┌───────┬───────┬───────┬───────┐
            //  ┌───────────┬───────┤       |       |       |       │               │       |       |   /   |   *   ├───────┬───────────┐
            //  │           |       ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   =   │           │      
            //  ├───────────┼───────┤       |   (   |   )   |       │               │       |   7   |   8   |   9   ├───────┼───────────┤
            //  │           |       ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   -   │           │
            //  ├───────────┼───────┤       |   {   |   }   |       │   ---------   │       |   4   |   5   |   6   ├───────┼───────────┤
            //  │           |       ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤   +   │           │
            //  ├───────────┼───────┤       |   <   |   >   |       │               |       |   1   |   2   |   3   ├───────┼───────────┤
            //  │   LCTRL   |   P   ├╤══════╧╤══════╧╤══════╧╤══════╧══╕         ╒══╧══════╤╧══════╤╧══════╤╧══════╤┤   M   │   LSHIFT  │
            //  └───────────┴───────┘│   M   |game2/J| ALT/I |  SPACE  │         |         |       |       |       |└───────┴───────────┘
            //                       └───────┴───────┴───────┴─────────┘         └─────────┴───────┴───────┴───────┘
            bindings = <
                &trans  &trans  &trans  &trans      &trans      &trans              &trans  &trans  &kp SLASH   &kp STAR    &kp EQUAL   &trans
                &trans  &trans  &trans  &kp LPAR    &kp RPAR    &trans              &trans  &kp N7  &kp N8      &kp N9      &kp MINUS   &trans
                &trans  &trans  &trans  &kp LBRC    &kp RBRC    &trans              &trans  &kp N4  &kp N5      &kp N6      &kp PLUS    &trans 
                &trans  &trans  &trans  &kp LT      &kp GT      &trans              &kp N0  &kp N1  &kp N2      &kp N3      &kp EQUAL   &trans  
                                &trans  &trans      &trans      &kp SPACE           &trans  &trans  &kp N0      &trans 
            >;
        };

    };
};

// Layer 4
            //                      ┌───────┬───────┬───────┬───────┐               ┌───────┬───────┬───────┬───────┐
            //  ┌───────────┬───────┤   1   |   2   |   3   |   4   │               │       |       |   /   |   *   ├───────┬───────────┐
            //  │    TAB    |   A   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤       │           │      
            //  ├───────────┼───────┤   W   |   E   |   R   |   T   │               │       |   7   |   8   |   9   ├───────┼───────────┤
            //  │    TAB    |   A   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤       │           │
            //  ├───────────┼───────┤   S   |   D   |   F   |   G   │   ---------   │       |   4   |   5   |   6   ├───────┼───────────┤
            //  │   LSHIFT  |   L   ├───────┼───────┼───────┼───────┤               ├───────┼───────┼───────┼───────┤       │           │
            //  ├───────────┼───────┤   X   |   C   |   V   |   B   │               |       |   1   |   2   |   3   ├───────┼───────────┤
            //  │   LCTRL   |   P   ├╤══════╧╤══════╧╤══════╧╤══════╧╕             ╒╧══════╤╧══════╤╧══════╤╧══════╤┤   =   │           │
            //  └───────────┴───────┘│   M   |game2/J| ALT/I |       │             |       |ooooooo|   0   |       |└───────┴───────────┘
            //                       └───────┴───────┴───────┴───────┘             └───────┴───────┴───────┴───────┘